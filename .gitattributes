# 줄바꿈은 저장소에 LF로 저장 (Windows·macOS 혼용 대비)
* text=auto eol=lf

# Windows 스크립트는 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Gradle wrapper 스크립트는 LF (리눅스 CI에서 실행)
gradlew text eol=lf

# 바이너리
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
