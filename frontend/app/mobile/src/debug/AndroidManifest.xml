<?xml version="1.0" encoding="utf-8"?>
<!-- 디버그 빌드에만 들어간다. 출시 빌드에는 워치 로그 중계·ADB 중계가 없다.
     adb shell 에서 부르는 진입점은 DUMP 권한을 요구해 같은 폰의 다른 앱은 부를 수 없다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>
        <receiver
            android:name=".debug.WatchLogPullReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <service
            android:name=".debug.WatchLogSink"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/candiy/log/data"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <service
            android:name=".debug.AdbRelayService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.DUMP">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Developer-only TCP relay from USB adb to watch wireless debugging" />
        </service>
    </application>
</manifest>
