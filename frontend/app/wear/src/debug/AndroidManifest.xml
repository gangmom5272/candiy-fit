<?xml version="1.0" encoding="utf-8"?>
<!-- 디버그 빌드에만 들어간다. 출시 빌드에는 로그 중계 기능이 없다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".WatchLogService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/candiy/log/request"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
