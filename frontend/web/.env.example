# 빌드할 때 브라우저 번들에 들어가는 공개 값이다. secret을 넣지 않는다.
# 소셜 로그인 client ID (docs/api-integration.md "Frontend 환경변수와 보안")
PUBLIC_GOOGLE_CLIENT_ID=
PUBLIC_KAKAO_REST_API_KEY=

# npm run dev에서만 적용. 백엔드 없이 (app) 화면을 볼 때 true
PUBLIC_SKIP_AUTH_GUARD=

# DB 마이그레이션 → API → Android 완료 보고 배포 확인 후에만 true. 변경 후 웹 재빌드 필요
PUBLIC_APP_CONNECTION_GUIDE=false
