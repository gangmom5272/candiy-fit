# 이 파일을 복사해 .env를 만들고 값을 채웁니다. (.env는 커밋 금지)

# ===== CANDiY API =====
CANDIY_BASE_URL=https://api.example.invalid
CANDIY_CLIENT_ID=
CANDIY_CLIENT_SECRET=

# ===== 사각 사내 LLM (OpenAI 규격) =====
LLM_BASE_URL=https://llm.example.invalid/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gemma4-31b
LLM_EMBEDDING_MODEL=bge-m3
# 사내 LLM 동시 요청 허용치
LLM_MAX_CONCURRENCY=3

# ===== LangSmith 추적 =====
# 모두 false로 둔다. 켜진 추적은 프롬프트와 도구 결과(건강 수치)를 외부 LangSmith로 보내므로
# 하나라도 켜져 있으면 모델 생성과 코칭 실행이 거부된다 (ai/src/coach_ai/security/tracing.py)
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
LANGCHAIN_TRACING=false
LANGCHAIN_TRACING_V2=false

# ===== PostgreSQL =====
# 로컬 개발용 값 (infra/docker-compose.yml). 서버에서는 다른 비밀번호를 쓴다.
# 호스트는 localhost가 아니라 127.0.0.1로 쓴다. DB 포트가 127.0.0.1(IPv4)에만 열려 있는데,
# Windows는 localhost를 IPv6(::1)로 먼저 연결해 응답 없이 멈춘다 (S15P31A403-120)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=candiy_fit
POSTGRES_USER=candiy
POSTGRES_PASSWORD=candiy_local

# ===== 데이터 파이프라인 (data/pipeline) =====
# 개발용 테스트 사용자 (CANDiY 조회 ID, 쉼표로 구분). 운영에서는 비워 둔다.
PIPELINE_TEST_USERS=
# 개발용. true면 CANDiY 샘플 앱 기록도 적재한다 (mock-1013은 기록이 모두 샘플 앱). 운영에서는 비워 둔다.
PIPELINE_INCLUDE_SAMPLE_APP=false
# false면 회원(users)을 CANDiY에 조회하지 않는다. 싸피 개발 서버는 합성 데이터만 쓰므로 false (실데이터 반출 방지)
PIPELINE_INCLUDE_MEMBERS=true
# 즉시 동기화 API도 두 스위치가 모두 true여야 수집한다. 수집 허용 확인 후 설정한다.
# 활성화 값은 배포 스크립트와 일치하도록 소문자 true로 입력한다.
PIPELINE_ENABLED=false
# 개발 서버 전용. 합성 데이터를 15분마다 다시 넣을 로그인 회원 "회원 UUID:페르소나" (쉼표로 구분, 예: <UUID>:synth-02)
# PIPELINE_INCLUDE_MEMBERS=false일 때만 쓴다 (data/pipeline/README.md)
PIPELINE_SYNTHETIC_MEMBERS=
# 주기 실행: 평소 실행 간격(분), 35일 전체 다시 조회 시각(KST 시)
PIPELINE_INTERVAL_MINUTES=15
PIPELINE_FULL_HOUR=4
# 실패 알림: Mattermost 수신 웹훅 URL(비밀값, 비우면 알림 끔), 메시지에 붙일 서버 이름 (예: 개발 서버, 운영 서버)
PIPELINE_ALERT_WEBHOOK_URL=
PIPELINE_ALERT_NAME=

# ===== 백엔드 (backend) =====
# local: 개발 PC / test: 자동 테스트 / dev·prod: 서버
APP_ENV=local
# 서비스 JWT 서명키. 최소 32바이트 암호학적 난수로 생성하여 모든 API 프로세스에 동일하게 주입
# 빈 값이면 API 시작 실패. 실제 키는 커밋하거나 로그에 남기지 않는다.
AUTH_SIGNING_KEY=
# 웹 개발 서버 주소. 여러 개면 쉼표로 구분
CORS_ALLOWED_ORIGINS=http://localhost:5173
# 웹 소셜 로그인. 제공자 콘솔에 등록한 정확한 콜백 URI 목록(쉼표 구분).
# 실제 비밀값은 환경으로 주입한다. 설정하지 않은 제공자의 로그인은 사용할 수 없다.
GOOGLE_CLIENT_ID=
# Android Credential Manager의 serverClientId도 위 GOOGLE_CLIENT_ID를 사용한다.
# Android 토큰 azp로 허용할 OAuth 클라이언트 ID(동일 Google 프로젝트, 쉼표 구분).
GOOGLE_ANDROID_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URIS=
# 로컬 HTTP: http://localhost:5173/auth/callback/google (콘솔에도 등록)
# HTTPS 선택 시 https://localhost:5173/auth/callback/google도 쉼표로 추가
KAKAO_REST_API_KEY=
# Android SDK 초기화에 사용한 네이티브 앱 키. REST API 키·숫자 앱 ID와 다르다.
# 같은 Kakao 앱의 OpenID Connect 활성화가 필요하다.
KAKAO_NATIVE_APP_KEY=
KAKAO_CLIENT_SECRET=
# REST API 키와 다른 숫자 앱 ID. 미설정 시 이 줄을 생략한다.
# KAKAO_APP_ID=123456
KAKAO_REDIRECT_URIS=
# 로컬 HTTP: http://localhost:5173/auth/callback/kakao (콘솔에도 등록)
# HTTPS 선택 시 https://localhost:5173/auth/callback/kakao도 쉼표로 추가

# ===== 서버 앞단 nginx (개발·운영 서버만) =====
# HTTPS 인증서를 발급한 도메인. 비우면 k15a403.p.ssafy.io (infra/README.md "앞단 nginx·HTTPS")
NGINX_SERVER_NAME=
